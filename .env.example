# Copie para .env (local) e cadastre os mesmos nomes no painel da Vercel.
# NUNCA faça commit do .env.

# Banco Postgres (Supabase ou Neon). Para o Supabase use a "Transaction pooler" e acrescente ?sslmode=require
DATABASE_URL=postgres://usuario:senha@host/neondb?sslmode=require

# Stripe (Dashboard > Developers > API keys). Use sk_test_ até validar tudo.
STRIPE_SECRET_KEY=sk_test_...
# Stripe (Dashboard > Developers > Webhooks > seu endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Texto aleatório longo (ex.: openssl rand -hex 32) para assinar o cookie de sessão
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# URL pública do site, sem barra no final (ex.: https://lulapad.vercel.app)
APP_URL=http://localhost:3000

# Créditos de boas-vindas para conta nova (padrão 10)
WELCOME_CREDITS=10

# Placar global em tempo real: Upstash Redis (https://upstash.com > Create Database > aba REST API).
# Sem estas duas variáveis o placar usa o Postgres: serve para testar, NÃO para muita gente ao mesmo tempo.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
