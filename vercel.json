{
  "headers": [
    { "source": "/sounds/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }] },
    { "source": "/(js|css)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=600" }] }
  ]
}
